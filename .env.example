# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to git.

# Port the local server runs on
PORT=3000

# Long random string used to sign admin login sessions.
# You can type any long random sentence here — it just needs to be secret.
SESSION_SECRET=change-this-to-a-long-random-string

# Credentials for the FIRST admin account.
# These are only used once, when you run "npm run create-admin".
# After that, the password is stored securely (hashed) in the database,
# and you can change these values or remove them.
ADMIN_EMAIL=admin@bengalurufriends.local
ADMIN_PASSWORD=change-this-password
