# Copy this file to ".env" for local development and fill in real values.
# Never commit the real ".env" file.

# --- Database ---
# For Docker Compose, this matches the "postgres" service below.
DATABASE_URL="postgresql://bengaluru_friends:changeme@localhost:5432/bengaluru_friends?schema=public"

# Used by docker-compose.yml to create the Postgres container.
POSTGRES_USER=bengaluru_friends
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bengaluru_friends

# --- Auth ---
# Long random string used to sign admin login session cookies (JWT).
AUTH_SECRET=change-this-to-a-long-random-string

# --- Seed admin account (used once by "npm run seed") ---
SEED_ADMIN_EMAIL=admin@bengalurufriends.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Media storage ---
# "local" stores uploads on disk (Docker volume) — good for local dev.
# In production on Vercel, switch this to "cloudinary" (or s3 / vercel-blob)
# and fill in the matching credentials below. See lib/storage.ts and
# DEPLOYMENT.md for how to wire up a different provider.
STORAGE_DRIVER=local

# Only needed if STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed if STORAGE_DRIVER=s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed if STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# App port (used by docker-compose.yml)
PORT=3000
